# Files that must not be copied into the image. Save as ".dockerignore" next to your Dockerfile.
.git
.github
node_modules
.svelte-kit
dist
build
__pycache__
.venv
venv
*.log
# Local configuration and secrets never belong into an image
.env
.env.*
!.env.example
# Local SQLite databases (the live database lives in a volume on the server)
*.db
*.sqlite
*.sqlite3
# Startbestand der Fragen-Datenbank: wird ins Image kopiert und beim ersten Start ins Volume gelegt
!data/Fragen.db
# Editor- und Tool-Konfiguration
.claude
.vscode
.DS_Store
